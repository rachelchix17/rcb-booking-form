# ============================================================================
#  Roof Cleaners Brisbane - Secure My Booking - Environment Variables
#  Copy these into Vercel (Project > Settings > Environment Variables).
#  NEVER commit real keys to the repo. The secret key stays server-side only.
#  These are the SAME values as the House Washing Experts project
#  (same Stripe account, same monday.com token).
# ============================================================================

# --- Stripe (get these from https://dashboard.stripe.com/apikeys) ---
# Use the LIVE keys (they begin with the live prefixes) for real bookings.
STRIPE_SECRET_KEY=paste-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=paste-stripe-publishable-key-here

# --- monday.com ---
# Personal API token: monday.com > click your avatar > Developers > My Access Tokens
MONDAY_API_TOKEN=paste-monday-api-token-here
# Accepted Quotes board = SOURCE (where the accepted quote currently sits)
MONDAY_BOARD_ID=5026836555
# Booked board = DESTINATION (the item is moved here on a successful booking)
MONDAY_BOOKED_BOARD_ID=5026732973

# --- Optional safety net ---
# A Zapier/Make "catch hook" URL. If monday is ever down, the booking is POSTed
# here instead so the lead is never lost (point it at an email/Sheet step).
FALLBACK_WEBHOOK_URL=
